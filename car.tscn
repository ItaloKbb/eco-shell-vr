[sub_resource type="Shader" id="Shader_vidro"]
code = "shader_type spatial;
render_mode cull_disabled, depth_draw_never;
// Bolha de policarbonato: quase invisível de frente, reflexo azul nas bordas (fresnel)
void fragment() {
	float borda = pow(1.0 - abs(dot(NORMAL, VIEW)), 3.0);
	ALBEDO = vec3(0.55, 0.75, 1.0);
	ALPHA = 0.04 + 0.55 * borda;
	METALLIC = 0.3;
	ROUGHNESS = 0.03;
	SPECULAR = 0.9;
	EMISSION = vec3(0.18, 0.55, 1.0) * borda * 0.5;
}
"

