; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="EcoShellVR"
run/main_scene="res://inicializador.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/main_scene.android="res://menu.tscn"

[autoload]

XRToolsUserSettings="*uid://bqgb8i74tm0t"
XRToolsRumbleManager="*uid://by853dk86g1qw"
Ranking="*res://ranking.gd"
Dispositivos="*res://dispositivos.gd"
Rede="*res://rede.gd"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
openxr/reference_space=0
openxr/startup_alert=false
openxr/extensions/hand_tracking=true
openxr/extensions/hand_interaction_profile=true
shaders/enabled=true
openxr/extensions/meta/render_model=true
openxr/extensions/meta/hand_tracking_mesh=true
