[sub_resource type="Shader" id="Shader_horizonte"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;
// Horizonte artificial: céu azul / chão laranja, girado pelo giro e deslocado pela inclinação
uniform float inclinacao = 0.0;
uniform float giro = 0.0;
void fragment() {
	vec2 p = vec2(UV.x * 2.0 - 1.0, 1.0 - UV.y * 2.0);
	float r = length(p);
	if (r > 1.0) discard;
	float c = cos(giro), s = sin(giro);
	vec2 q = vec2(c * p.x - s * p.y, s * p.x + c * p.y);
	float h = q.y + inclinacao / 1.5708 * 0.85;
	vec3 cor = mix(vec3(0.85, 0.32, 0.12), vec3(0.1, 0.35, 0.9), step(0.0, h));
	// Escada de inclinação a cada 30° e linha do horizonte
	float escada = (1.0 - smoothstep(0.0, 0.02, abs(fract(h / 0.2833 + 0.5) - 0.5) * 0.2833)) * step(abs(q.x), 0.25);
	cor = mix(cor, vec3(0.9), escada * 0.6);
	cor = mix(cor, vec3(1.0), 1.0 - smoothstep(0.0, 0.035, abs(h)));
	// Símbolo fixo do carro e moldura
	float asa = (1.0 - smoothstep(0.03, 0.05, abs(p.y))) * step(abs(p.x), 0.55) * step(0.15, abs(p.x));
	cor = mix(cor, vec3(1.0, 0.85, 0.2), max(asa, step(r, 0.06)));
	cor = mix(cor, vec3(0.03, 0.03, 0.07), smoothstep(0.86, 0.92, r));
	ALBEDO = cor;
}
"

